   "metadata": {},
   "source": [
    "### Vocalic\n",
    "\n",
    "This code block uses the diff[] array plotted above to define a **vocalic** feature, \n",
    "and then uses that feature to clean up the formant plot.  This is really only needed for \n",
    "nice looking graphs.  Illustrating here the three main formant tracking algorithms."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "9ec53f08-c213-4c77-acb2-ebcdd7854c37",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "IFC_tracking(), using method ifc, with speaker set to 2, and pitch range [63, 400]\n",
      "Prep Audio: Resampling from 16000 to 12000\n",
      " done         \n"
     ]
    },
    {
     "data": {
      "text/plain": [
       "<Axes: xlabel='Time (sec)', ylabel='Frequency (Hz)'>"
      ]
     },
     "execution_count": 42,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 864x324 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "example_file = importlib.resources.files('phonlab') / 'data' / 'example_audio' / 'sf3_cln.wav'\n",
    "\n",
    "# 1) IFC formant tracking\n",
    "x,fs = phon.loadsig(example_file, chansel=[0])\n",
    "\n",
    "# 2) Python native LPC formant tracking\n",
    "fmtsdf = phon.track_formants(x,fs,method='ifc',order = 10, speaker=2)\n",
    "\n",
    "# 3) Praat LPC formant tracking\n",
    "snd = parselmouth.Sound(str(example_file))  # create a Praat Sound object\n",
    "maxf = 6000       # use 5000 for men, 6000 for women, 8000 for children\n",
    "fmnt = snd.to_formant_burg(maximum_formant=maxf)  # create a Praat Formant object\n",
    "fmtdf = phon.formant_to_df(fmnt, 4, include_bw=False)  # convert it into a Pandas dataframe\n",
    "\n",
    "# ------ use \"vocalic\" to decide which formant measurements to draw --------  # note pre=0 is important here\n",
    "lband, fs_diff = phon.amplitude_envelope(x,fs,bounds=[120,3000],target_fs=12000)\n",
    "hband, fs_diff = phon.amplitude_envelope(x,fs,bounds=[3000,5999],target_fs=12000)\n",
    "diff = lband-hband  # the difference in the low and high envelopes\n",
    "fmtsdf[\"vocalic\"] = diff[(fmtsdf['sec']*fs_diff).astype(int)]>0.005  # add 'vocalic' to the dataframe\n",
    "fmtsdf.loc[fmtsdf[\"vocalic\"] == False, (\"F1\",\"F2\",\"F3\",\"F4\")] = np.nan # ignore nonvocalic formants\n",
    "\n",
    "phon.sgram(x,fs, cmap=\"Blues\")  # plot the spectrogram\n",
    "\n",
    "# add formant dots to the spectrogram\n",
    "dot_color = \"red\"\n",
    "sns.pointplot(fmtsdf,x='sec',y='F1',linestyle='none',native_scale=True,marker=\".\",color=dot_color)\n",
    "sns.pointplot(fmtsdf,x='sec',y='F2',linestyle='none',native_scale=True,marker=\".\",color=dot_color)\n",
    "sns.pointplot(fmtsdf,x='sec',y='F3',linestyle='none',native_scale=True,marker=\".\",color=dot_color)\n",
    "sns.pointplot(fmtsdf,x='sec',y='F4',linestyle='none',native_scale=True,marker=\".\",color=dot_color)\n",
    "\n",
    "dot_color = \"lightgreen\"\n",
    "sns.pointplot(fmtdf,x='sec',y='F1',linestyle='none',native_scale=True,marker=\".\",color=dot_color)\n",
    "sns.pointplot(fmtdf,x='sec',y='F2',linestyle='none',native_scale=True,marker=\".\",color=dot_color)\n",
    "sns.pointplot(fmtdf,x='sec',y='F3',linestyle='none',native_scale=True,marker=\".\",color=dot_color)\n",
    "sns.pointplot(fmtdf,x='sec',y='F4',linestyle='none',native_scale=True,marker=\".\",color=dot_color)"
   ]
  },
