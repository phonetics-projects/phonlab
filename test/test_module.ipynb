    "## phon.amplitude_envelope()\n",
    "\n",
    "Here's an intersting application of one of the phonab functions.  Get the amplitude envelope in a low frequency band, and then in a high frequency band.  The difference between them (plotted in red over the spectrogram below) segments the speech into consonant and vowel regions.  Above zero is 'vocalic' and below zero is 'consonantal'."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "482444dc-6c14-456e-8402-7a97f70f266d",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/html": [
       "\n",
       "                <audio  controls=\"controls\" >\n",
       "                    <source src=\"data:audio/x-wav;base64,\" type=\"audio/x-wav\" />\n",
       "                    Your browser does not support the audio element.\n",
       "                </audio>\n",
       "              "
      ],
      "text/plain": [
       "<IPython.lib.display.Audio object>"
      ]
     },
     "execution_count": 41,
     "metadata": {},
     "output_type": "execute_result"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 864x324 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "example_file = importlib.resources.files('phonlab') / 'data' / 'example_audio' / 'sf3_cln.wav'\n",
    "\n",
    "x,fs = phon.loadsig(example_file, chansel=[0])\n",
    "\n",
    "lband, fs_diff = phon.amplitude_envelope(x,fs,bounds=[120,3000],target_fs=12000)\n",
    "hband, fs_diff = phon.amplitude_envelope(x,fs,bounds=[3000,5999],target_fs=12000)\n",
    "\n",
    "diff = lband-hband  # the difference in the low and high envelopes\n",
    "time_axis = np.arange(len(diff))/fs_diff  # a time axis for envelope plotting\n",
    "\n",
    "ax1,f,t,Sxx = phon.sgram(x,fs,cmap='Blues') # draw the spectrogram from the array of samples\n",
    "\n",
    "ax2 = ax1.twinx()\n",
    "ax2.plot(time_axis,diff, color = \"red\")  # add scaled diff function\n",
    "ax2.axhline(0) \n",
    "\n",
    "Audio(example_file)"
   ]
  },
