   "source": [
    "\n",
    "print(\"deltaf\\tvtl\\torder\\ttopfreq\")\n",
    "for deltaf in range(800,1500,25):\n",
    "    vtl = 35300/(2*deltaf)\n",
    "    #deltaf = 35300/(vtl * 2)\n",
    "    topfreq = 8000\n",
    "    order = round((topfreq-(deltaf/2))/deltaf)*2\n",
    "    topfreq = (order*deltaf)/2 \n",
    "\n",
    "    mydeltaf = topfreq/(order/2)    \n",
    "\n",
    "    print(f\"{deltaf:.0f}\\t{vtl:.2f}\\t{order}\\t{topfreq:.0f}\\t{mydeltaf}\")"
   ]
  },
