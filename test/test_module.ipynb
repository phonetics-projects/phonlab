    "# --------\n",
    "\n",
    "y,fs = phon.prep_audio(x,fs_orig,outtype='int')\n",
    "print(np.max(y))\n",
    "\n",
    "y,fs = phon.prep_audio(x,fs_orig,outtype='float')\n",
    "print(np.max(y))"
