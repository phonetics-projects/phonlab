    "example_file = importlib.resources.files('phonlab') / 'data/example_audio/fricatives.wav'\n",
    "x,fs = phon.loadsig(example_file, chansel=[0])\n",
    "if fs>32000: target_fs=32000\n",
    "else: target_fs = fs\n",
    "y,fs = phon.prep_audio(x,fs, target_fs = target_fs, outtype = 'int')\n",
    "\n",
    "frics_list = {\"/f/\": 0.322, \"/θ/\": 1.235, \"/s/\": 2.158, \n",
    "              \"/ʃ/\": 3.214, \"/x/\": 4.189, \"/h/\": 5.06}\n",
    "\n",
    "fig,axes = plt.subplots(nrows=3,ncols=2,sharex=\"all\",sharey=\"all\")\n",
    "print(axes.shape)\n",
    "\n",
    "row = col = 0\n",
    "for key,value in frics_list.items():\n",
    "    fricmeas = phon.fricative(y,fs,value)\n",
    "\n",
    "    ax = axes[row][col]\n",
    "    ax.plot(fricmeas.freq,fricmeas.spec)\n",
    "    ax.axvline(fricmeas.Fm,color=\"red\")\n",
    "    ax.text(15000,61,key)\n",
    "    ax.text(10000,46,f\"COG={fricmeas.COG:.0f}\")\n",
    "    ax.text(10000,39,f\"Fm={fricmeas.Fm:.0f}\")\n",
    "    ax.text(10000,32,f\"AmpD={fricmeas.AmpD:.0f}\")\n",
    "    if not np.isnan(fricmeas.Fsec): \n",
    "        ax.axvline(fricmeas.Fsec,color=\"red\")\n",
    "    ax.axvline(fricmeas.COG,color=\"green\")\n",
    "    col = col + 1\n",
    "    if col>1:\n",
    "        col=0\n",
    "        row = row + 1\n"
   ]
  },
