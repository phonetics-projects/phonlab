    "                extent = extent, origin='lower')\n",
    "ax1.grid(which='major', axis='y', linestyle=':')  # add grid lines\n",
    "ax1.set_xlabel(\"Time (sec)\", size=14)\n",
    "ax1.set_ylabel(\"Frequency (mels)\", size=14)\n",
    "plt.tick_params(labelsize=14)"
