    "plt.plot(time_axis - 0.5,y)  # add_noise pads the signal by 0.5 seconds\n",
    "y,fs = phon.prep_audio(y,fs,target_fs=None,pre=0)\n",
    "phon.sgram(y,fs)\n",
    "Audio(y,rate=fs) "
