    "start = 0\n",
    "end = -1\n",
    "\n",
    "fig, axes_list = phon.make_figure(height_ratios)\n",
    "\n",
    "for i in range(len(tiersdf)):\n",
    "    try:\n",
    "        phon.plot_tier(tiersdf[i], start, end, ax=axes_list[i],\n",
    "                       mark_in_plot=[axes_list[-1],axes_list[-2]])\n",
    "    except:\n",
    "        pass\n",
    "wav = phon.display_wave(x,fs,start, end, ylabel=\"\", font_size=8, ax=axes_list[-2], color=\"teal\")\n",
    "ret = phon.sgram(x,fs,start, end, ax=axes_list[-1],cmap=\"Reds\")\n",
    "\n",
    "spectrogram_height = sgram_height\n",
    "figheight = spectrogram_height * np.sum(height_ratios)/np.max(height_ratios)\n",
    "\n",
    "(oldwidth, oldheight) = fig.get_size_inches()\n",
    "fig.set_size_inches(oldwidth, figheight) # resize it by the values here\n"
